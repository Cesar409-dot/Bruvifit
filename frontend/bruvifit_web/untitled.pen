                },
                {
                  "type": "text",
                  "id": "z3g6qY",
                  "name": "UX-01 · Decidir com a equipe: reabertura de pedidos con",
                  "fill": "#3b4542ff",
                  "textGrowth": "fixed-width",
                  "width": 1308,
                  "content": "A partir da tela 01: (1) Novo pedido → Cadastrar cliente → Voltar → Salvar → Pedidos; (2) pedido #126 → Editar → Salvar → Concluir → confirmação → Concluído; (3) conclusão → Estoque → Ajustar → Registrar → sucesso; (4) conclusão → Financeiro → Consultar pedido #126 → Ajustar recebido → Salvar → sucesso; (5) pedido #128 cancelado somente consulta; (6) status do #127 Pendente → Em andamento. Conferir navegação por teclado, foco, mensagens e ausência de dupla conclusão.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
