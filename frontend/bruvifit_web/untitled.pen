                {
                  "type": "text",
                  "id": "w5X1Ly",
                  "name": "UX-01 · Decidir com a equipe: reabertura de pedidos con",
                  "fill": "#3b4542ff",
                  "textGrowth": "fixed-width",
                  "width": 1308,
                  "content": "Decidir com a equipe: reabertura de pedidos concluídos/cancelados; correção ou reversão após conclusão; tratamento financeiro de cancelamentos e pagamentos já recebidos; fluxos de recuperação de erros operacionais. Não criar estorno automático sem decisão formal. O aceite final de UX-01 depende dos responsáveis e do teste manual da apresentação.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
