              "layoutIncludeStroke": true,
              "children": [
                {
                  "type": "text",
                  "id": "naWy1",
                  "name": "Título",
                  "fill": "#17453bff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 36,
                  "content": "02 · Exemplo de concorrência realista",
                  "lineHeight": 1.5,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "letterSpacing": -0.4000000059604645
                },
                {
                  "type": "text",
                  "id": "KocVL",
                  "name": "Informação",
                  "fill": "#404a45ff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 26,
                  "content": "CAM-002 (G/Preto), mínimo 10. Operador A abre o formulário vendo saldo 8 e pede aumento +3 com motivo “Três unidades encontradas na contagem física”. Enquanto isso, uma venda/alteração de outro operador reduz o saldo 8 → 5. Ajuste antigo 8 → 11 não pode ser salvo automaticamente.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "y6gdp",
              "name": "UX-09 · 03 · Conflito detectado: resposta segura",
              "clip": true,
              "width": 1356,
              "fill": "#ffffffff",
              "cornerRadius": 10,
              "stroke": "#dde1ddff",
              "strokeWidth": 1,
              "strokeAlignment": "inner",
