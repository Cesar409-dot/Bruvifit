              "children": [
                {
                  "type": "text",
                  "id": "jsizA",
                  "name": "Título",
                  "fill": "#17453bff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 36,
                  "content": "01 · Objetivo prático",
                  "lineHeight": 1.5,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "letterSpacing": -0.4000000059604645
                },
                {
                  "type": "text",
                  "id": "McihD",
                  "name": "Informação",
                  "fill": "#404a45ff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 26,
                  "content": "Permitir ajustes rápidos por uma ou duas pessoas sem sobrescrever alterações recentes nem duplicar movimentações. Não impor aprovações em múltiplos níveis. Dados e motivos preenchidos não devem desaparecer ao ocorrer conflito.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "JRJ3w",
              "name": "UX-09 · 02 · Exemplo de concorrência realista",
              "clip": true,
              "width": 1356,
