                },
                {
                  "type": "text",
                  "id": "noJ2X",
                  "name": "UX-01 · Decidir com a equipe: reabertura de pedidos con",
                  "fill": "#3b4542ff",
                  "textGrowth": "fixed-width",
                  "width": 1308,
                  "content": "Protótipo: Pedido → Confirmar → Processando → queda de rede simulada → Consultar resultado → escolher cenário demonstrativo: concluído, não executado ou consulta indisponível. Há alternativa de estoque insuficiente. O painel “somente protótipo Figma” NÃO entra na aplicação final. PENDENTE EQUIPE: revisão de UX, teste manual de navegação, teclado, foco, anúncios e aceite; não foram feitos aqui.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
