                  "fill": "#174036ff",
                  "textGrowth": "fixed-width",
                  "width": 1308,
                  "content": "10 · Roteiro de validação manual (apresentação)",
                  "lineHeight": 1.5,
                  "fontFamily": "Manrope",
                  "fontSize": 18,
