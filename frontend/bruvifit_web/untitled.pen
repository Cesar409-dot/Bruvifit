              ],
              "layoutIncludeStroke": true,
              "children": [
                {
                  "type": "text",
                  "id": "sHfeC",
                  "name": "Título",
                  "fill": "#17453bff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 36,
                  "content": "03 · Conflito detectado: resposta segura",
                  "lineHeight": 1.5,
                  "fontFamily": "Montserrat",
                  "fontSize": 18,
                  "fontWeight": "700",
                  "letterSpacing": -0.4000000059604645
                },
                {
                  "type": "text",
                  "id": "qPxZP",
                  "name": "Informação",
                  "fill": "#404a45ff",
                  "textGrowth": "fixed-width-height",
                  "width": 1308,
                  "height": 26,
                  "content": "O backend compara a versão do estoque lida com a versão atual. Se o saldo mudou, não aplica ajuste; retorna conflito com saldo confirmado 5 e versão nova. A UI mostra “saldo mudou”, mantém +3 e motivo, e oferece Comparar e Atualizar prévia. Nunca sobrescrever a contagem com o saldo antigo.",
                  "lineHeight": 1.5384615384615385,
                  "fontFamily": "Manrope",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "vEGiB",
              "name": "UX-09 · 04 · Recalcular e revisar o novo saldo",
              "clip": true,
              "width": 1356,
              "fill": "#ffffffff",
